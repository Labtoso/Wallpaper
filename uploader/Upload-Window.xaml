<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper Upload" Width="1060" Height="760" MinWidth="880" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#111214" Foreground="#E9EAEC"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#85888E"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#D2D4D8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#34363B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#797D85"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E9EAEC"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#2E3239"/><Setter TargetName="Surface" Property="BorderBrush" Value="#2E3239"/><Setter Property="Foreground" Value="#7F8793"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,7"/>
      <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Foreground" Value="#A8ABB1"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#222428"/><Setter Property="Foreground" Value="#EEEFF1"/>
      <Setter Property="BorderBrush" Value="#383B41"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#585C65"/>
      <Setter Property="Padding" Value="11,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Field" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#A7ABB3"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#B7BAC0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" BorderBrush="#60646D" BorderThickness="1" Background="#1C1E22" Margin="0,0,9,0">
            <Path x:Name="Tick" Data="M 3 8 L 7 12 L 14 4" Stroke="#111214" StrokeThickness="1.8" Visibility="Collapsed"/>
          </Border><ContentPresenter VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#E9EAEC"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#191B1F"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#464A52" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PackItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#A8ABB1"/><Setter Property="Padding" Value="11,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="PackSurface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="PackSurface" Property="Background" Value="#2A2D33"/><Setter Property="Foreground" Value="#F0F1F3"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PackSurface" Property="Background" Value="#24262B"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#111214">
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#181A1E" BorderBrush="#2A2D32" BorderThickness="0,0,1,0" Padding="25,29,23,24">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="wallpaper" FontSize="27" FontWeight="SemiBold" Foreground="#F1F2F4"/><TextBlock Text="Upload" Margin="1,4,0,0" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,40,0,0">
          <TextBlock Text="Packname" Foreground="#C4C7CD" Margin="0,0,0,10"/>
          <TextBox x:Name="PackName" ToolTip="Neuen Packnamen eingeben oder unten ein vorhandenes Pack auswählen"/>
          <TextBlock x:Name="TargetPath" Text="assets / …" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Margin="1,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,28,0,0">
          <TextBlock Text="Vorhandene Packs" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ListBox x:Name="ExistingPacks" Background="Transparent" BorderThickness="0" MaxHeight="180" ItemContainerStyle="{StaticResource PackItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <TextBlock x:Name="NoPacks" Text="Noch keine Pack-Ordner." Foreground="#686D77" FontSize="11" Margin="1,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4">
          <Border BorderBrush="#30333A" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>
          <TextBlock Text="Projekt" Foreground="{StaticResource Muted}" FontSize="11"/>
          <TextBlock x:Name="ProjectPath" Foreground="#B3B7BE" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,5"/>
          <Button x:Name="BrowseProject" Content="Projekt ändern …" Style="{StaticResource TextButton}"/>
          <Button x:Name="OpenWebsite" Content="Website öffnen ↗" Style="{StaticResource TextButton}" Margin="0,9,0,0"/>
          <Button x:Name="Login" Content="GitHub anmelden" Style="{StaticResource TextButton}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,29,32,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Deine Auswahl" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Bilder hinzufügen und als Pack veröffentlichen." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
        <TextBlock x:Name="SelectionCount" Grid.Column="1" Text="0 Bilder" Foreground="#A9ADB5" VerticalAlignment="Top" Margin="14,9,0,0" FontSize="12"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,28,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="AddFiles" Content="Bilder auswählen"/>
        <Button x:Name="AddFolder" Grid.Column="1" Content="Ordner hinzufügen" Margin="9,0,0,0"/>
        <Button x:Name="ClearSelection" Grid.Column="2" Content="Auswahl leeren" Style="{StaticResource TextButton}" HorizontalAlignment="Right" FontSize="11"/>
      </Grid>
      <Border x:Name="DropArea" Grid.Row="2" Background="#17191D" BorderBrush="#2A2D33" BorderThickness="1" CornerRadius="7" AllowDrop="True" MinHeight="150">
        <Grid>
          <StackPanel x:Name="EmptySelection" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="22">
            <Viewbox Width="40" Height="34" Margin="0,0,0,20"><Path Data="M 2 7 L 16 7 L 21 12 L 42 12 L 42 34 L 2 34 Z M 2 12 L 42 12" Stroke="#626974" StrokeThickness="1.2" Fill="Transparent"/></Viewbox>
            <TextBlock Text="Dateien hier ablegen" FontSize="17" Foreground="#CDD0D6" HorizontalAlignment="Center"/>
            <TextBlock Text="Oder oben Bilder und Ordner auswählen." FontSize="11" Foreground="#777E89" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
          <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Margin="8" Foreground="#D7DAE0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#21242A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid Margin="8,9"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <Border Width="66" Height="48" Background="#262A31" CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Left"><Grid><TextBlock Text="{Binding FileType}" Foreground="#727A86" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E0E3E9" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="#727A86" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Foreground="#949BA7" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                <Button Grid.Column="3" Content="×" Tag="{Binding SourcePath}" Padding="5" BorderThickness="0" FontSize="20" Foreground="#7E8591" ToolTip="Nur aus der Auswahl entfernen" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,14,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SizeHint" Text="Originale bleiben unverändert · bis 100 MiB pro Bild" FontSize="10" Foreground="#747C87" VerticalAlignment="Center"/>
        <Button x:Name="ToggleDetails" Grid.Column="1" Content="Details" Style="{StaticResource TextButton}" FontSize="11" HorizontalAlignment="Right"/>
      </Grid>
      <StackPanel Grid.Row="4">
        <TextBox x:Name="Log" Height="105" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="10" Foreground="#939BA8" Background="#14161A" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,16"/>
        <Border BorderBrush="#2A2D33" BorderThickness="0,1,0,0" Padding="0,20,0,0">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="Bereit" Foreground="#BCC2CC" FontSize="12" Margin="0,0,0,10"/><CheckBox x:Name="LocalOnly" Content="Nur lokal hinzufügen" FontSize="11"/></StackPanel>
              <Button x:Name="Upload" Grid.Column="1" Content="Hochladen" Width="154" Height="44" Background="#E8EBF0" Foreground="#17191D" BorderBrush="#E8EBF0" FontWeight="SemiBold" IsEnabled="False"/>
            </Grid>
            <ProgressBar x:Name="Progress" Height="3" Foreground="#D0D6E0" Background="#272B32" BorderThickness="0" IsIndeterminate="True" Visibility="Collapsed" Margin="0,17,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
